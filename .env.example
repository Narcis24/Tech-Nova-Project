# Copy to .env (git-ignored) and fill in. Only POSTGRES_PASSWORD is required;
# everything else has the default shown in docker-compose.yml.

# Database
POSTGRES_PASSWORD=change-me
POSTGRES_USER=technova
POSTGRES_DB=technova
POSTGRES_PORT=5434

# Auth: set a long random value outside local development
JWT_SECRET=change-this-secret-key-in-production

# Alpaca market data for the execution engine. Without these the poller runs but
# every quote request fails, so market orders are rejected for lack of a quote.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Host ports
APP_PORT=8081
AUTH_PORT=8082
SONAR_PORT=8083
KAFKA_UI_PORT=8085
