# Copy to .env (git-ignored) and fill in.
# Required values must be set or docker-compose refuses to start. Optional values left
# empty fall back to the default in brackets, which lives in docker-compose.yml.
# Keep comments on their own lines: compose reads "KEY=   # note" as the value "# note".

# Database
# POSTGRES_PASSWORD: required
# POSTGRES_USER [technova], POSTGRES_DB [technova], POSTGRES_PORT [5434]: optional
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=

# Auth: required, at least 32 bytes, shared by app and auth-service.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Alpaca market data for the execution engine (optional). Without these the poller runs but
# every quote request fails, so market orders are rejected for lack of a quote.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Host ports (optional): APP_PORT [8081], AUTH_PORT [8082], SONAR_PORT [8083], KAFKA_UI_PORT [8085]
APP_PORT=
AUTH_PORT=
SONAR_PORT=
KAFKA_UI_PORT=
