# Copy to .env (git-ignored) and fill in, then run: docker-compose up -d
# Required values must be set or docker-compose refuses to start. Optional values left
# empty fall back to the default in brackets, which lives in docker-compose.yml.
# Keep comments on their own lines: compose reads "KEY=   # note" as the value "# note".

# Database
# POSTGRES_PASSWORD: required
# POSTGRES_USER [technova], POSTGRES_DB [technova], POSTGRES_PORT [5434]: optional
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=

# Test admin (optional, local dev only): set a password to get an ADMIN user "test_admin" when the
# database is first created (12-20 characters). Leave empty on any shared or deployed server.
# Takes effect only on a fresh database: run db/scripts/reset.sh after changing it.
TEST_ADMIN_PASSWORD=

# Auth: required, at least 32 bytes, shared by app and auth-service.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Admin journal page (optional): a secret shared by app and execution engine. Without it the page
# says the journal is unavailable. Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Alpaca market data for the execution engine (optional; free keys at https://alpaca.markets).
# Without these the poller runs but every quote request fails, so during market hours
# market orders are rejected for lack of a quote.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Optional services started with a plain "docker-compose up" (comma-separated, optional):
# mail = Mailpit, catches password reset emails (inbox on MAILPIT_PORT)
# quality = SonarQube (heavy, about 2 GB of memory)
# Set COMPOSE_PROFILES=mail to try password reset; leave empty to start only the core stack.
COMPOSE_PROFILES=

# Host ports (optional): APP_PORT [8081], AUTH_PORT [8082], SONAR_PORT [8083],
# KAFKA_UI_PORT [8085], MAILPIT_PORT [8025]
APP_PORT=
AUTH_PORT=
SONAR_PORT=
KAFKA_UI_PORT=
MAILPIT_PORT=

# Angular production UI [8091]; ng serve remains on 4200/8090.
UI_PORT=

# Link in password reset emails (optional) [http://localhost:<UI_PORT>/reset-password].
# It must be an address the reader's browser can open:
# - on a cloud VM, use its IP, e.g. http://<vm-ip>:8091/reset-password (hostname -I shows it)
# - with ng serve, use http://localhost:4200/reset-password
RESET_URL=

# SonarQube token for local scans (optional): create one in SonarQube under
# My Account > Security, then run: SONAR_TOKEN=<token> ./sonar/scan.sh (see README).
SONAR_TOKEN=
