  "components": {
    "schemas": {
      "UpdateRiskLimitRequest": {
        "type": "object",
        "properties": {
          "thresholdPct": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "RiskLimitResponse": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "SINGLE_INSTRUMENT",
              "ASSET_CLASS",
              "CASH_FLOOR"
            ]
          },
          "thresholdPct": {
            "type": "number"
          },
          "direction": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "CUSTOM"
            ]
          }
        }
      },
      "PlaceOrderRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1
          },
          "side": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?i)BUY|SELL"
          },
          "orderType": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?i)MARKET|LIMIT"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "maximum": 100000,
            "minimum": 1
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "accountId",
          "idempotencyKey",
          "orderType",
          "quantity",
          "side",
          "symbol"
        ]
      },
      "RiskWarning": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "SINGLE_INSTRUMENT",
              "ASSET_CLASS",
              "CASH_FLOOR"
            ]
          },
          "subject": {
            "type": "string"
          },
          "resultingPct": {
            "type": "number"
          },
          "limitPct": {
            "type": "number"
          },
          "limitSource": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "CUSTOM"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "orderType": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT"
            ]
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PUBLISHED",
              "FILLED",
              "CANCELLED",
              "REJECTED",
              "PARTIALLY_FILLED",
              "EXPIRED"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "OpenAccountRequest": {
        "type": "object",
        "properties": {
          "holderName": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "holderName"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "holderName": {
            "type": "string"
          },
          "cashBalance": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "SUSPENDED",
              "PENDING",
              "CLOSED"
            ]
          }
        }
      },
      "CashAmountRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "amount"
        ]
      },
      "PriceResponse": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "PositionResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "averageCost": {
            "type": "number"
          },
          "currentPrice": {
            "type": "number"
          },
          "marketValue": {
            "type": "number"
          },
          "unrealizedPnL": {
            "type": "number"
          }
        }
      },
      "PositionMetricsResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "averageCost": {
            "type": "number"
          },
          "currentPrice": {
            "type": "number"
          },
          "marketValue": {
            "type": "number"
          },
          "unrealizedPnL": {
            "type": "number"
          },
          "returnPercentage": {
            "type": "number"
          }
        }
      },
      "InstrumentResponse": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "assetClass": {
            "type": "string",
            "enum": [
              "EQUITY",
              "BOND",
              "COMMODITY",
              "ETF"
            ]
          },
          "currency": {
            "type": "string"
          },
          "tradable": {
            "type": "boolean"
          }
        }
      },
      "PortfolioSnapshotResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "cashBalance": {
            "type": "number"
          },
          "totalMarketValue": {
            "type": "number"
          },
          "totalPortfolioValue": {
            "type": "number"
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PositionResponse"
            }
          }
        }
      },
      "PortfolioMetricsResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "cashBalance": {
            "type": "number"
          },
          "totalMarketValue": {
            "type": "number"
          },
          "totalPortfolioValue": {
            "type": "number"
          },
          "totalUnrealizedPnL": {
            "type": "number"
          },
          "portfolioReturn": {
            "type": "number"
          },
          "positions": {
