server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Preserve the API prefixes expected by each backend. Docker DNS is resolved
    # per request so the UI survives backend container replacement.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_backend ${API_UPSTREAM};
    set $auth_backend ${AUTH_UPSTREAM};
    location ~ ^/api(?:/|$) {
        proxy_pass http://$api_backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ~ ^/auth(?:/|$) {
        proxy_pass http://$auth_backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /index.html {
        add_header Cache-Control 'no-cache';
    }
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
